{
  "data_dir": "data/",
  "metadata_csv": "data/metadata.csv",
  "modality": "ct",
  "patch_size": 256,
  "batch_size": 16,
  "num_workers": 8,

  "in_channels": 3,
  "num_organs": 3,
  "latent_dim": 256,
  "n_codebooks": 8,
  "codebook_size": 1024,
  "init_temperature": 5.0,
  "use_anatomical_attention": true,

  "lambda_rate": 0.005,
  "lambda_vq": 0.25,
  "lambda_perceptual": 0.005,
  "lambda_ssim": 0.15,
  "lambda_sparsity": 0.0005,
  "lambda_roi": 0.1,
  "lambda_diversity": 0.5,
  "lambda_fg_align": 0.5,
  "fg_align_warmup": 3,

  "epochs": 100,
  "learning_rate": 1e-4,
  "weight_decay": 1e-4,
  "warmup_epochs": 5,
  "temperature_unfreeze_epoch": 5,
  "perceptual_warmup": 30,
  "ssim_warmup": 10,

  "log_interval": 400,
  "checkpoint_interval": 5,
  "viz_interval": 5,

  "image_size": [256, 256],
  "latent_hw": [16, 16],

  "val_frac": 0.15,
  "test_frac": 0.15,
  "split_save_path": "split_indices.json",

  "masks_dir": "data/masks/",
  "output_dir": "training_output",
  "diag_save_dir": "diagnostic_results",
  "drive_checkpoint_dir": "checkpoints"
}
